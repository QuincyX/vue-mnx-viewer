{
  "name": "@quincyx/vue-mnx-viewer",
  "version": "0.1.0",
  "type": "module",
  "description": "Vue 3 component for rendering W3C MNX scores, powered by @viritura/score-engine and @viritura/score-viewer.",
  "keywords": [
    "mnx",
    "music-notation",
    "score",
    "sheet-music",
    "vue",
    "vue3",
    "viritura",
    "w3c"
  ],
  "license": "MIT",
  "author": "QuincyX",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuincyX/vue-mnx-viewer.git"
  },
  "homepage": "https://github.com/QuincyX/vue-mnx-viewer#readme",
  "bugs": {
    "url": "https://github.com/QuincyX/vue-mnx-viewer/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/types/vite-plugin.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./samples": {
      "types": "./dist/types/samples/index.d.ts",
      "import": "./dist/samples.js",
      "default": "./dist/samples.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/changelog.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts && vue-tsc -p tsconfig.build.json && node scripts/fix-declarations.mjs",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build:lib",
    "prepare": "pnpm build:lib"
  },
  "dependencies": {
    "@viritura/score-engine": "0.2.0",
    "@viritura/score-viewer": "0.1.1"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "^5.7.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  }
}
